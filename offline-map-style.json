{
  "version": 8,
  "name": "Real Earth Street War - Offline New Jersey",
  "metadata": {
    "description": "Complete offline map style using local PMTiles data for New Jersey"
  },
  "sources": {
    "nj-complete": {
      "type": "vector",
      "url": "pmtiles://tiles/nj-complete.pmtiles"
    }
  },

  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0c8f0",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#d0e0c0",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#e0f0d0",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#f0f0e8",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "landuse",
      "filter": ["==", "class", "commercial"],
      "paint": {
        "fill-color": "#f0e8e8",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c8e0b0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "transportation-path",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "paint": {
        "line-color": "#d0d0d0",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "transportation-minor",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[12, 1], [16, 4]]
        }
      }
    },
    {
      "id": "transportation-secondary",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[10, 1], [16, 6]]
        }
      }
    },
    {
      "id": "transportation-primary",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[8, 1], [16, 8]]
        }
      }
    },
    {
      "id": "transportation-trunk",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#ffd700",
        "line-width": {
          "stops": [[6, 1], [16, 10]]
        }
      }
    },
    {
      "id": "transportation-motorway",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#ff6b6b",
        "line-width": {
          "stops": [[4, 1], [16, 12]]
        }
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {
        "line-color": "#888888",
        "line-width": 2,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#7bb3f0",
        "line-width": {
          "stops": [[10, 1], [16, 4]]
        }
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#999999",
        "line-width": 2,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "nj-complete",
      "source-layer": "aeroway",
      "filter": ["==", "class", "runway"],
      "paint": {
        "line-color": "#dddddd",
        "line-width": {
          "stops": [[10, 2], [16, 20]]
        }
      }
    },
    {
      "id": "building-footprints",
      "type": "fill",
      "source": "nj-complete",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e0e0e0",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "nj-complete",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#d0d0d0",
        "fill-extrusion-height": [
          "case",
          ["has", "render_height"],
          ["to-number", ["get", "render_height"]],
          8
        ],
        "fill-extrusion-base": [
          "case",
          ["has", "render_min_height"],
          ["to-number", ["get", "render_min_height"]],
          0
        ],
        "fill-extrusion-opacity": 0.8
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "water_name",
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-width": 8,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#4a90e2",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "transportation-name-minor",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 15,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "transportation-name-major",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "primary", "secondary", "trunk", "motorway"],
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": {
          "stops": [[12, 10], [16, 14]]
        },
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-labels-city",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": {
          "stops": [[6, 12], [12, 18]]
        },
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-labels-town",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "minzoom": 8,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": {
          "stops": [[8, 10], [14, 16]]
        },
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels-village",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "place",
      "filter": ["in", "class", "village", "hamlet"],
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[10, 9], [16, 14]]
        },
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "nj-complete",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [0, 0.5]
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    }
  ]
} 