{
  "name": "realearthstreetwar-server",
  "version": "1.0.0",
  "description": "Server for RealEarthStreetWar game",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo 'Note: Build requires shared files from ../src. Use dev mode or set up monorepo.' && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@shared/realearthstreetwar": "*",
    "@turf/turf": "^7.2.0",
    "bitecs": "^0.3.40",
    "pbf": "^4.0.1",
    "pmtiles": "^4.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
